# ============================================================
# VAULT-X Production & Staging Environment Variables
# ============================================================

# Application Runtime
PORT=3000
NODE_ENV=production

# Store Public Information (KWD Currency & Store Name)
VITE_STORE_NAME=اسم المتجر
VITE_CURRENCY=KWD

# Payment Gateway Configuration (Tap Payments / Production Mode)
GATEWAY_PROVIDER=tap
GATEWAY_MODE=production

# Tap Payments API Credentials (obtain from https://tap.company dashboard)
# Leave empty for security until entered by the merchant / store owner
TAP_SECRET_KEY=
TAP_PUBLIC_KEY=

# Webhook Cryptographic Secret (for verifying Tap HMAC-SHA256 signatures)
# Leave empty until webhook endpoint is configured in Tap dashboard
WEBHOOK_SECRET=

# Merchant Bank Settlement Details (direct bank payout from Tap account)
# Leave empty until merchant provides official bank account details
MERCHANT_IBAN=
MERCHANT_BANK_NAME=
MERCHANT_ACCOUNT_HOLDER=
